AZURE_FOUNDRY_RESOURCE_NAME=your-foundry-resource-name
# Or set AZURE_FOUNDRY_BASE_URL=https://your-foundry-resource.services.ai.azure.com/openai/v1/
# Or set AZURE_FOUNDRY_ENDPOINT=https://your-foundry-resource.services.ai.azure.com

# Optional only if you don't want Microsoft Entra / az login auth
# AZURE_FOUNDRY_API_KEY=your-foundry-key

AZURE_FOUNDRY_CHAT_DEPLOYMENT=Kimi-K2.5
AZURE_FOUNDRY_EMBEDDING_DEPLOYMENT=embed-v-4-0
AZURE_FOUNDRY_EMBEDDING_DIMENSIONS=1536

AZURE_SEARCH_SERVICE_NAME=your-search-service-name
# Or set AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net

# Optional only if you don't want Microsoft Entra / az login auth
# AZURE_SEARCH_API_KEY=your-search-admin-key

AZURE_SEARCH_INDEX_NAME=ca-rag-documents
FRONTEND_ORIGIN=http://localhost:3000
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_CHUNKING_STRATEGY=Paragraph-based
AZURE_FOUNDRY_TEMPERATURE=0.2
